# mock: executa com dados de demonstração. api: consulta a API real.
DATA_SOURCE=mock

# loop mantém o sincronizador em execução; run_once executa uma única vez.
SCHEDULE_MODE=loop
SYNC_INTERVAL_SECONDS=600

# Diretórios e arquivo de saída
OUTPUT_DIR=output
EXCEL_FILENAME=dados_gerenciador.xlsx
STATE_FILE=state/sync_state.json
SHEET_NAME=Dados

# Chaves usadas para impedir duplicação. Altere para os campos reais da API.
RECORD_ID_FIELD=id
UPDATED_AT_FIELD=updated_at

# ---- Preencha somente para DATA_SOURCE=api ----
API_BASE_URL=
API_ENDPOINT=
API_TOKEN=
API_TOKEN_HEADER=Authorization
API_TOKEN_PREFIX=Bearer
API_TIMEOUT_SECONDS=30

# Caminhos no JSON da resposta, separados por ponto. Ex.: result.items
# Se os registros vierem como uma lista na raiz, deixe API_RECORDS_PATH vazio.
API_RECORDS_PATH=
API_NEXT_PAGE_PATH=

# Informe apenas parâmetros confirmados pela documentação da API.
# Exemplos possíveis, não são valores assumidos pelo script:
API_UPDATED_SINCE_PARAM=
API_PAGE_PARAM=
API_PAGE_SIZE_PARAM=
API_PAGE_SIZE=100
